{
    "name": "@meteo-render/mars3d",
    "version": "1.1.1",
    "description": "Mars3D and Cesium adapters for meteo-render visualizations",
    "main": "dist/index.cjs",
    "types": "dist/types/index.d.ts",
    "module": "dist/index.mjs",
    "browser": "dist/index.umd.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "obfuscate": "node ../../build/obfuscate.mjs",
        "build": "npm run clean && npm run build:rolldown && npm run build:types && npm run obfuscate",
        "prepack": "npm run build",
        "clean": "esno scripts/clean.ts",
        "build:rolldown": "rolldown -c rolldown.config.mjs",
        "build:types": "tsc -p tsconfig.types.json"
    },
    "keywords": [],
    "author": "wangrl",
    "license": "Apache-2.0",
    "type": "module",
    "files": [
        "dist",
        "package.json"
    ],
    "dependencies": {
        "@meteo-render/core": "^1.1.1",
        "@meteo-render/raster": "^1.1.1",
        "@meteo-render/rendering": "^1.1.1",
        "@meteo-render/volume": "^1.1.1"
    },
    "devDependencies": {
        "@tsconfig/node24": "latest",
        "@types/node": "latest",
        "@webgpu/types": "0.1.71",
        "esno": "latest",
        "javascript-obfuscator": "latest",
        "rolldown": "latest",
        "typescript": "latest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/priestqing/meteo-render.git",
        "directory": "packages/mars3d"
    },
    "bugs": {
        "url": "https://github.com/priestqing/meteo-render/issues"
    },
    "homepage": "https://github.com/priestqing/meteo-render#readme"
}
